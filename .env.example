# Garimpo SP — Variáveis de ambiente
# Copia esse arquivo pra .env e preenche com tuas keys
# .env está no .gitignore — NÃO comita

# Google AI Studio (Gemini) - Imagen 3 / Veo 2 / Gemini 2.0
GEMINI_API_KEY=cole_a_key_do_aistudio_aqui

# Buffer (opcional - pra automação programmatic via API)
BUFFER_ACCESS_TOKEN=

# Amazon Associates Brasil
AMAZON_ASSOCIATE_TAG=garimposp-20

# Anthropic (opcional - pra geração de captions)
ANTHROPIC_API_KEY=
